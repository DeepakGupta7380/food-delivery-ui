function waitForElement(selector, callback) {
	var observer = new MutationObserver(function(mutationsList) {
		for (var mutation of mutationsList) {
			if (mutation.type === "childList") {
				var element = document.querySelector(selector);
				if (element) {
					callback(element);
					observer.disconnect();
					return;
				}
			}
		}
	});

	observer.observe(document.body, {
		childList: true,
		subtree: true
	});
}


window.addEventListener("scroll", function() {
	var header = document.querySelector(".primary-header");
	if (window.scrollY > 50) {
		header.classList.add("scrolled");
	} else {
		header.classList.remove("scrolled");
	}
});


function getUrlParameter(param) {
    var pageUrl = window.location.search.substring(1);
    var urlVariables = pageUrl.split('&');

    for (var i = 0; i < urlVariables.length; i++) {
        var parameterName = urlVariables[i].split('=');
        
        if (parameterName[0] === param) {
            return decodeURIComponent(parameterName[1]);
        }
    }
    
    return null;
}


jQuery(document).ready(function($){
	waitForElement('.journey-slider .swiper', function() {
		const journeySlider = $('.journey-slider .swiper')[0].swiper;
		journeySlider.params.centeredSlides = true;
		journeySlider.update();	
		
		const paginationBullets = $('.journey-slider .swiper-pagination-bullet');
		
		$(paginationBullets[0]).addClass('active');
		
		journeySlider.on('slideChange', function () {
			const currentIndex = this.activeIndex;
			let currentActiveBullet = $('.journey-slider .swiper-pagination-bullet.swiper-pagination-bullet-active').attr('data-bullet-index');
			
			$('.journey-slider .swiper-pagination-bullet.active').css('--bullet-width', '100%');

			setTimeout(() => {
				$('.journey-slider .swiper-pagination-bullet.active').removeClass('active');
				$(paginationBullets[currentActiveBullet]).addClass('active');
				$(paginationBullets).css('--bullet-width', '40%');
			}, 400);
		});
	});
	
	
	waitForElement('#press-release .swiper', function() {
		const journeySlider = $('#press-release .swiper')[0].swiper;
		journeySlider.params.centeredSlides = true;
		journeySlider.update();	
	});
	
	
	waitForElement('#management-team-slider .swiper', function() {
		const managementSlider = $('#management-team-slider .swiper')[0].swiper;
 		managementSlider.params.slidesPerView = 3.5;
		managementSlider.update();
	});
	
	
	waitForElement('#board-directors-slider .swiper', function() {
		const boardDirectorsSlider = $('#board-directors-slider .swiper')[0].swiper;
 		boardDirectorsSlider.params.slidesPerView = 3.5;
		boardDirectorsSlider.update();
	});
	
	if (window.matchMedia("(max-width: 768px)").matches) {
		waitForElement('#media-kit-slider .swiper', function() {
			const mediaKitSlider = $('#media-kit-slider .swiper')[0].swiper;
			mediaKitSlider.params.slidesPerView = 1.5;
			mediaKitSlider.update();
		});
	}

	if (window.matchMedia("(max-width: 768px)").matches) {
		waitForElement('#delivering-page-slider .swiper', function() {
			const deliveringSlider = $('#delivering-page-slider .swiper')[0].swiper;
			deliveringSlider.params.slidesPerView = 1.4;
			deliveringSlider.update();
		});
	}

	// slider about as page 
	if (window.matchMedia('(max-width: 576px)').matches) {
		waitForElement('#management-team-slider .swiper', function() {
			const managementSlider = $('#management-team-slider .swiper')[0].swiper;
			managementSlider.params.slidesPerView = 1.4;
			managementSlider.update();
		});

		waitForElement('#board-directors-slider .swiper', function() {
			const boardDirectorsSlider = $('#board-directors-slider .swiper')[0].swiper;
			boardDirectorsSlider.params.slidesPerView = 1.3;
			boardDirectorsSlider.update();
		});
	}

	// about page slider blog
	if (window.matchMedia("(max-width: 768px)").matches) {
		waitForElement('.about-page-slider-blog .swiper', function() {
			const deliveringSlider = $('.about-page-slider-blog .swiper')[0].swiper;
			deliveringSlider.params.slidesPerView = 1.4;
			deliveringSlider.update();
		});
	}

	
	if (AOS) {
		AOS.init({
			duration: 1000,
			once: true
		});
	}


	function scrollToSection(targetSection, offsetValue = 112) {
		var target = $('#' + targetSection);
		if (target.length) {
			$('html, body').scrollTop(target.offset().top - offsetValue);
		}
	}

	$('a[data-scroll]').on('click', function(e) {
		e.preventDefault();
		var targetSection = $(this).data('scroll');
		var offsetValue = $(this).data('offset') || 112;
		if (targetSection) {
			scrollToSection(targetSection, offsetValue);
		}
	});
	
	$(document).ready(function() {
		var targetSection = getUrlParameter('data-scroll');
		var offsetValue = parseInt(getUrlParameter('data-offset')) || 112;
		if (targetSection) {
			scrollToSection(targetSection, offsetValue);
		}
	});
	
	
	// Call the function when the page is scrolled
	// 	$(window).on("scroll", function () {
	// 	if ($(".scrolled").length) {
	// 			fadeOutHeader();
	// 	}
	// 	});
	
	// 	header animation
	// 	function fadeOutHeader() {
	// 		const $headerMenu = $(".header-main-menu");
	// 		$headerMenu.addClass("fade-out");
	// 		$headerMenu.one("transitionend", function () {
	// 			$headerMenu.css("display", "none");
	// 		});
	// 	}
	
	
	
	// IR menu js 
	let lastScrollTop = 0;
	$(document).ready(function () {
		$(window).on("scroll", function () {
			const section = $(".header-main-menu");
			const sectionTop = section[0].getBoundingClientRect().top;
			const screenPosition = window.innerHeight / 1.3;
			let currentScroll = $(this).scrollTop();

			if (currentScroll > lastScrollTop) {
				section.removeClass("header-scroll-up");
			} else {
				if (sectionTop < screenPosition) {
					section.addClass("header-scroll-up");
				}
			}
			if (currentScroll === 0) {
				section.removeClass("header-scroll-up");
			}
			lastScrollTop = currentScroll;
		});
	});
	
	$(document).ready(function() {
		$('.aos-animate[data-aos="fade-in"]').each(function() {
			$(this).on('animationend', function() {
				$(this).addClass('my-custom-class');
			});
		});
	});
	
	// scroll video stop
	waitForElement('.video-stop-iframe iframe', function() {
		const iframes = document.querySelectorAll('.video-stop-iframe iframe');

		const observer = new IntersectionObserver((entries) => {
			entries.forEach(entry => {
				const iframe = entry.target;

				if (!entry.isIntersecting) {
					iframe.contentWindow.postMessage('{"event":"command","func":"pauseVideo","args":""}', '*');
				}
			});
		});

		iframes.forEach(iframe => {
			observer.observe(iframe);
		});
	});
});


// Main-1-js start
document.addEventListener("DOMContentLoaded", function () {
	const offset = 100;
	function adjustScroll() {
		if (window.location.hash) {
			const element = document.querySelector(window.location.hash);
			if (element) {
				const elementPosition = element.getBoundingClientRect().top + window.pageYOffset;
				const offsetPosition = elementPosition - offset;
				window.scrollTo({
					top: offsetPosition,
					behavior: "smooth"
				});
			}
		}
	}
	adjustScroll();
	document.querySelectorAll('a[href^="#"]').forEach(anchor => {
		anchor.addEventListener("click", function (e) {
			e.preventDefault();
			const targetId = this.getAttribute("href");
			const targetElement = document.querySelector(targetId);
			if (targetElement) {
				const elementPosition = targetElement.getBoundingClientRect().top + window.pageYOffset;
				const offsetPosition = elementPosition - offset;

				window.scrollTo({
					top: offsetPosition,
					behavior: "smooth"
				});
			}
		});
	});
});



